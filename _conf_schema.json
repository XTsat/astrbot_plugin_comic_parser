{
  "channels": {
    "type": "template_list",
    "description": "下载渠道",
    "hint": "内置渠道默认启用，装好即可用；要停用把对应渠道的「启用」关掉",
    "templates": {
      "jmcomic": {
        "name": "JM 漫画（jm）",
        "items": {
          "enable": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "client_type": {
            "type": "string",
            "description": "客户端类型",
            "hint": "API 接口兼容性好；网页端效率高但限制地区",
            "default": "api",
            "options": [
              "api",
              "html",
              "api_custom",
              "html_custom"
            ],
            "labels": [
              "API 接口",
              "网页端",
              "自定义 API 接口",
              "自定义网页端"
            ]
          },
          "api_domains": {
            "type": "text",
            "description": "自定义 API 接口域名",
            "hint": "一行一个，从上到下依次尝试：前一个失败自动换下一个；开启「下载前测速择优」时会先测速，把最快的排到最前面",
            "default": "www.cdnhjk.net\nwww.cdnutc.cc\nwww.cdngwc.net\nwww.cdngwc.club"
          },
          "html_domains": {
            "type": "text",
            "description": "自定义网页端域名",
            "hint": "一行一个，从上到下依次尝试：前一个失败自动换下一个；开启「下载前测速择优」时会先测速，把最快的排到最前面",
            "default": "18comic.vip\n18comic.ink\njmcomic-zzz.one\njmcomic-zzz.org\ncomic18j-moco.work\ncomic18j-nico.site\ncomic18j-ada.work"
          },
          "request_timeout": {
            "type": "int",
            "description": "请求超时（秒）",
            "hint": "单次请求的超时秒数，默认 30；调小能让坏节点更快放弃，调大更适合慢速网络",
            "default": 30,
            "slider": {
              "min": 5,
              "max": 120,
              "step": 5
            }
          },
          "image_suffix": {
            "type": "string",
            "description": "图片格式",
            "hint": "下载图片保存的扩展名",
            "default": ".jpg",
            "options": [
              ".jpg",
              ".png",
              ".webp"
            ]
          },
          "retry_times": {
            "type": "int",
            "description": "单请求重试次数",
            "hint": "单个网络请求失败后的重试次数；调小让坏节点更快放弃，调大更适合不稳定的网络",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            }
          },
          "max_concurrent_photos": {
            "type": "int",
            "description": "并发章节数",
            "hint": "同时下载的章节数量，建议 3-5",
            "default": 3,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            }
          },
          "max_concurrent_images": {
            "type": "int",
            "description": "并发图片数",
            "hint": "每个章节同时下载的图片数量，建议 5-10",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 20,
              "step": 1
            }
          },
          "use_proxy": {
            "type": "bool",
            "description": "使用代理",
            "hint": "开启后走上方全局代理地址（全局代理留空时等于直连）；JM 有国内镜像，一般不用开",
            "default": false
          }
        }
      },
      "nhentai": {
        "name": "nhentai（nh）",
        "items": {
          "enable": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "site_domains": {
            "type": "text",
            "description": "站点域名",
            "hint": "一行一个，从上到下依次降级；开启「下载前测速择优」时会先测速，把最快的站点域名排到最前面。官方 API v2 与页面抓取共用这份清单，镜像站换这里即可",
            "default": "nhentai.net"
          },
          "image_domains": {
            "type": "text",
            "description": "图床域名",
            "hint": "留空则自动从站点接口取图床清单（推荐）；也可手填一行一个，多个候选会按实测速度挑最快的那个",
            "default": ""
          },
          "request_timeout": {
            "type": "int",
            "description": "请求超时（秒）",
            "hint": "单次请求的超时秒数，默认 30；站点在 Cloudflare 后面，偶尔慢，调太小容易误判失败",
            "default": 30,
            "slider": {
              "min": 5,
              "max": 120,
              "step": 5
            }
          },
          "max_concurrent_images": {
            "type": "int",
            "description": "并发图片数",
            "hint": "同时下载的图片数量，图床对高并发敏感，建议 3-8",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 20,
              "step": 1
            }
          },
          "retry_times": {
            "type": "int",
            "description": "单张图片重试次数",
            "hint": "单张图片下载失败后的重试次数；图床抖动常见，2 次够用，调大会拖长整本耗时",
            "default": 2,
            "slider": {
              "min": 0,
              "max": 10,
              "step": 1
            }
          },
          "use_proxy": {
            "type": "bool",
            "description": "使用代理",
            "hint": "按「插件代理 → AstrBot 本体代理 → 直连」取代理；nhentai 在多数网络环境下需要代理才能访问",
            "default": true
          }
        }
      },
      "picacg": {
        "name": "哔咔漫画（pica）",
        "items": {
          "enable": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "account": {
            "type": "string",
            "description": "哔咔账号邮箱",
            "hint": "必填：哔咔没有匿名访问，没登录就取不到章节与图片",
            "default": ""
          },
          "password": {
            "type": "string",
            "description": "哔咔密码",
            "hint": "建议使用小号，密码只存在插件配置里",
            "default": "",
            "secret": true
          },
          "secret_key": {
            "type": "string",
            "description": "签名密钥",
            "hint": "默认用哔咔 app 的公开密钥；只有签名算法变更时才需要改",
            "default": "~d}$Q7$eIni=V)9\\RK/P.RM4;9[7|@/CA}b~OW!3?EV`:<>M7pddUBL5n|0/*Cn",
            "secret": true
          },
          "request_timeout": {
            "type": "int",
            "description": "请求超时（秒）",
            "hint": "单次请求的超时秒数；哔咔接口在部分网络下较慢，不建议低于 15",
            "default": 30,
            "slider": {
              "min": 5,
              "max": 120,
              "step": 5
            }
          },
          "retry_times": {
            "type": "int",
            "description": "单请求重试次数",
            "hint": "单个请求失败后的重试次数，0 表示不重试",
            "default": 3,
            "slider": {
              "min": 0,
              "max": 10,
              "step": 1
            }
          },
          "max_concurrent_images": {
            "type": "int",
            "description": "并发图片数",
            "hint": "同时下载的图片数量，建议 3-6；调太高一容易被上游限速",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 20,
              "step": 1
            }
          },
          "use_proxy": {
            "type": "bool",
            "description": "使用代理",
            "hint": "按「插件代理 → AstrBot 本体代理 → 直连」取代理；哔咔需要能访问境外的网络环境，多数服务器要开",
            "default": true
          }
        }
      },
      "hanime1": {
        "name": "Hanime1 漫画（hm）",
        "items": {
          "enable": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "site_domains": {
            "type": "text",
            "description": "站点域名",
            "hint": "一行一个，从上到下依次尝试；开启「下载前测速择优」时会先直连测速，把最快的站点域名排到最前面。漫画区现在在 hanimeone.me，hanime1.me 上老作品仍可访问",
            "default": "hanimeone.me\nhanime1.me"
          },
          "image_domains": {
            "type": "text",
            "description": "图床域名（一般留空）",
            "hint": "留空＝用阅读页给出的图床地址（i / i2 / i3 会变）；只有在它也不通时才手动填，例如 i.nhentai.net",
            "default": ""
          },
          "fetch_proxy": {
            "type": "string",
            "description": "读取代理地址",
            "hint": "默认用公开读取服务 r.jina.ai 代取页面（图片仍直连图床）；不想让页面经过第三方就清空，清空后只直连站点",
            "default": "https://r.jina.ai/"
          },
          "request_timeout": {
            "type": "int",
            "description": "请求超时（秒）",
            "hint": "单次请求的超时秒数，默认 30；站点在 Cloudflare 后面偶尔慢，调太小容易误判失败",
            "default": 30,
            "slider": {
              "min": 5,
              "max": 120,
              "step": 5
            }
          },
          "max_concurrent_images": {
            "type": "int",
            "description": "并发图片数",
            "hint": "同时下载的图片数量，建议 3-6；图床对高并发比较敏感",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 20,
              "step": 1
            }
          },
          "retry_times": {
            "type": "int",
            "description": "单请求重试次数",
            "hint": "单张图片失败后的重试次数，0 表示不重试",
            "default": 2,
            "slider": {
              "min": 0,
              "max": 10,
              "step": 1
            }
          },
          "use_proxy": {
            "type": "bool",
            "description": "使用代理",
            "hint": "按「插件代理 → AstrBot 本体代理 → 直连」取代理；站点被 Cloudflare 拦时通常要靠代理换出口 IP",
            "default": true
          }
        }
      },
      "wnacg": {
        "name": "紳士漫畫（ssmh）",
        "items": {
          "enable": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "site_domains": {
            "type": "text",
            "description": "站点域名",
            "hint": "一行一个，从上到下依次降级；站点换域名时改这里即可（不要带 https:// 前缀）",
            "default": "www.wnacg.buzz\nwww.wnacg.site"
          },
          "request_timeout": {
            "type": "int",
            "description": "请求超时（秒）",
            "hint": "单次请求的超时秒数，默认 30；站点在 Cloudflare 后面，偶尔慢，调太小容易误判失败",
            "default": 30,
            "slider": {
              "min": 5,
              "max": 120,
              "step": 5
            }
          },
          "max_concurrent_images": {
            "type": "int",
            "description": "并发图片数",
            "hint": "同时下载的图片数量，建议 2-8；图床是独立域名，但对高并发同样敏感",
            "default": 4,
            "slider": {
              "min": 1,
              "max": 20,
              "step": 1
            }
          },
          "retry_times": {
            "type": "int",
            "description": "单张图片重试次数",
            "hint": "单张图片下载失败后的重试次数；图床抖动常见，2 次够用",
            "default": 2,
            "slider": {
              "min": 0,
              "max": 10,
              "step": 1
            }
          },
          "use_proxy": {
            "type": "bool",
            "description": "使用代理",
            "hint": "大陆线路实测可直连，默认关闭；访问超时或被墙时再开启，按「插件代理 → AstrBot 本体代理 → 直连」取代理",
            "default": false
          }
        }
      },
      "ehentai": {
        "name": "E-Hentai（eh）",
        "items": {
          "enable": {
            "type": "bool",
            "description": "启用",
            "default": true
          },
          "site_domains": {
            "type": "text",
            "description": "站点域名",
            "hint": "一行一个，从上到下依次降级；e-hentai.org 匿名可用，exhentai.org 需要登录 Cookie（未填 Cookie 时自动跳过）。开启「下载前测速择优」时会先测速，把最快的站点域名排到最前面",
            "default": "e-hentai.org\nexhentai.org"
          },
          "use_proxy": {
            "type": "bool",
            "description": "使用代理",
            "hint": "按「插件代理 → AstrBot 本体代理 → 直连」取代理；E-Hentai 在多数大陆网络下需要代理才能访问",
            "default": true
          },
          "request_timeout": {
            "type": "int",
            "description": "请求超时（秒）",
            "hint": "单次请求的超时秒数，默认 30；站点在境外，偶有抖动，调太小容易误判失败",
            "default": 30,
            "slider": {
              "min": 5,
              "max": 120,
              "step": 5
            }
          },
          "request_interval": {
            "type": "float",
            "description": "页面请求间隔（秒）",
            "hint": "作品页/图片页两次请求之间至少间隔这么久；站点对翻页速率敏感，调太小容易触发临时封禁，默认 1 秒",
            "default": 1.0,
            "slider": {
              "min": 0,
              "max": 5,
              "step": 0.1
            }
          },
          "max_concurrent_images": {
            "type": "int",
            "description": "并发图片数",
            "hint": "同时下载的图片数量；站点按 IP 记图片配额，建议 2-4",
            "default": 3,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            }
          },
          "retry_times": {
            "type": "int",
            "description": "单张图片重试次数",
            "hint": "单张图片因 5xx/网络抖动失败后的重试次数；配额 509 与登录墙不重试",
            "default": 2,
            "slider": {
              "min": 0,
              "max": 10,
              "step": 1
            }
          },
          "max_pages": {
            "type": "int",
            "description": "最多下载页数",
            "hint": "单次最多下多少页，0 表示不限；大 gallery 建议设上限配合分段续跑，避免一次占用太久",
            "default": 0,
            "slider": {
              "min": 0,
              "max": 2000,
              "step": 50
            }
          },
          "download_original": {
            "type": "bool",
            "description": "优先原图",
            "hint": "配置了登录 Cookie 时优先下原图（按 10×文件大小 MB 扣站点图片配额），单页取不到自动回退 1280px；未配置 Cookie 时本项无效，固定下 1280px 重采样",
            "default": true
          },
          "cookie": {
            "type": "string",
            "description": "登录 Cookie",
            "hint": "可选。填 ipb_member_id、ipb_pass_hash（exhentai 还需 igneous），多个用分号连接，如 ipb_member_id=...; ipb_pass_hash=...；留空=匿名，只能下 1280px 重采样。Cookie 等同账号凭据，泄露等于交出账号",
            "default": "",
            "secret": true
          }
        }
      }
    },
    "default": [
