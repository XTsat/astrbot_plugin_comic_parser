  "access": {
    "type": "object",
    "description": "会话与限制",
    "hint": "决定哪些会话能触发下载、多久内不重复下载同一本",
    "items": {
      "whitelist": {
        "type": "list",
        "description": "白名单会话",
        "hint": "填写会话 ID（即会话的唯一标识），留空表示不限制。白名单非空时，只有列表内的会话可以使用下载命令，优先级高于黑名单",
        "default": []
      },
      "blacklist": {
        "type": "list",
        "description": "黑名单会话",
        "hint": "黑名单内的会话无法使用下载命令",
        "default": []
      },
      "debounce_interval": {
        "type": "int",
        "description": "防抖秒数",
        "hint": "同一会话在该时间内重复请求同一本漫画时直接忽略，避免刷屏与重复下载；0 表示关闭",
        "default": 60,
        "slider": {
          "min": 0,
          "max": 600,
          "step": 10
        }
      }
    }
  },
  "download": {
    "type": "object",
    "description": "下载与网络",
    "hint": "网络出口、进度提示、并发上限、超时重试与断点",
    "items": {
      "proxy": {
        "type": "string",
        "description": "代理地址",
        "hint": "渠道里勾选「使用代理」后，请求与测速都走这里；留空则用 AstrBot 本体的 http_proxy，都没有就直连",
        "default": ""
      },
      "progress_style": {
        "type": "string",
        "description": "进度提示方式",
        "hint": "贴表情：在命令消息上贴 ❤️，完成换 OK、失败换 🔨，不刷屏；文本进度：按 25% 步进推消息；关闭：不提示",
        "default": "emoji",
        "options": [
          "emoji",
          "text",
          "none"
        ],
        "labels": [
          "贴表情",
          "文本进度",
          "关闭"
        ]
      },
      "show_result_summary": {
        "type": "bool",
        "description": "发送下载完成摘要",
        "hint": "关闭后只发文件，不再附「标题 / 作者 / 图片数 / 耗时」那段说明（仅本地保存模式仍会提示保存路径）",
        "default": true
      },
      "max_concurrent_tasks": {
        "type": "int",
        "description": "同时下载任务数",
        "hint": "全局同时进行的下载任务数量上限，超出的请求排队等待",
        "default": 1,
        "slider": {
          "min": 1,
          "max": 5,
          "step": 1
        }
      },
      "timeout": {
        "type": "int",
        "description": "单本下载超时（秒）",
        "hint": "一整本漫画从开始下载到结束的超时时间，超时即判失败并重试",
        "default": 1800,
        "slider": {
          "min": 120,
          "max": 7200,
          "step": 60
        }
      },
      "retry_times": {
        "type": "int",
        "description": "下载失败重试次数",
