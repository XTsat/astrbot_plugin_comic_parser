        "hint": "全渠道榜单每个渠道各展示前几名；不同站点的热度口径不同，所以只并列展示、不混排",
        "default": 5,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        }
      },
      "cache_ttl": {
        "type": "int",
        "description": "榜单缓存时长（秒）",
        "hint": "同一渠道、同一时间窗在有效期内复用上次结果；榜单变化比搜索慢，可以设长一些，0 表示不缓存",
        "default": 300,
        "slider": {
          "min": 0,
          "max": 3600,
          "step": 30
        }
      },
      "cooldown": {
        "type": "int",
        "description": "看榜冷却（秒）",
        "hint": "同一会话两次看榜之间至少间隔这么久；0 表示不限制",
        "default": 3,
        "slider": {
          "min": 0,
          "max": 60,
          "step": 1
        }
      }
    }
  }
}
