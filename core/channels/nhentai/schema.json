{
  "name": "nhentai（nh）",
  "items": {
    "enable": {
      "type": "bool",
      "description": "启用",
      "default": true
    },
    "site_domains": {
      "type": "text",
      "description": "站点域名",
      "hint": "一行一个，从上到下依次降级；官方 API v2 与页面抓取共用这份清单，镜像站换这里即可",
      "default": "nhentai.net"
    },
    "image_domains": {
      "type": "text",
      "description": "图床域名",
      "hint": "留空则自动从站点接口取图床清单（推荐）；也可手填一行一个，取第一个",
      "default": ""
    },
    "request_timeout": {
      "type": "int",
      "description": "请求超时（秒）",
      "hint": "单次请求的超时秒数，默认 30；站点在 Cloudflare 后面，偶尔慢，调太小容易误判失败",
      "default": 30,
      "slider": {
        "min": 5,
        "max": 120,
        "step": 5
      }
    },
    "max_concurrent_images": {
      "type": "int",
      "description": "并发图片数",
      "hint": "同时下载的图片数量，图床对高并发敏感，建议 3-8",
      "default": 5,
      "slider": {
        "min": 1,
        "max": 20,
        "step": 1
      }
    },
    "retry_times": {
      "type": "int",
      "description": "单张图片重试次数",
      "hint": "单张图片下载失败后的重试次数；图床抖动常见，2 次够用，调大会拖长整本耗时",
      "default": 2,
      "slider": {
        "min": 0,
        "max": 10,
        "step": 1
      }
    },
    "use_proxy": {
      "type": "bool",
      "description": "使用代理",
      "hint": "开启后使用上方全局代理地址；nhentai 在多数网络环境下需要代理才能访问",
      "default": false
    }
  }
}
